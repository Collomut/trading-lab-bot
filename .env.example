# ============================================================
# AUTOMATED CRYPTO TRADING BOT - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================================

# --- Exchange Configuration ---
# For paper trading, use Binance Testnet:
#   1. Go to https://testnet.binance.vision
#   2. Log in with GitHub
#   3. Generate API Key and Secret
EXCHANGE=binance
API_KEY=your_testnet_api_key_here
API_SECRET=your_testnet_api_secret_here

# Set to true for paper trading (uses testnet)
# Set to false for live trading (WARNING: uses real money!)
PAPER_TRADING=true

# Live order placement is deliberately blocked by this build. Keep false.
ALLOW_LIVE_TRADING=false

# Required to protect every dashboard/API endpoint (generate a long random value).
DASHBOARD_TOKEN=replace_with_a_long_random_secret

# On Railway, mount a Volume at /app/data and set DATA_DIR=/app/data.
DATA_DIR=data

# --- Trading Pairs ---
# Comma-separated list of trading pairs to monitor
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT

# --- Risk Management ---
# Maximum percentage of portfolio to risk per trade (1-2% recommended)
MAX_RISK_PER_TRADE=1.0

# Maximum number of simultaneous open positions
MAX_OPEN_POSITIONS=3

# Stop-loss percentage (how much loss before auto-selling)
STOP_LOSS_PCT=2.0

# Take-profit percentage (how much gain before auto-selling)
TAKE_PROFIT_PCT=3.0

# Maximum percentage of portfolio to lose in a single day before stopping
MAX_DAILY_LOSS_PCT=3.0

# Percentage of available balance to use per trade
POSITION_SIZE_PCT=10.0

# --- Strategy Settings ---
# Available strategies: ema_crossover, rsi_mean_reversion, combined
STRATEGY=combined

# Timeframe for candle data (1h recommended for low noise; 15m for more frequent trades)
TIMEFRAME=1h

# Number of historical candles to fetch for analysis
LOOKBACK_CANDLES=150

# --- Notifications ---
# Set to true to enable console notifications for trades
ENABLE_NOTIFICATIONS=true

# Optional: Instant Telegram alerts for buys, sells, stop-loss, and take-profit
# Create a bot via @BotFather on Telegram, then get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log

# ============================================================
# AUTOMATED CRYPTO TRADING BOT - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================================

# --- Exchange Configuration ---
# Paper trading modes for Binance:
#   testnet: https://testnet.binance.vision (separate account and order book)
#   demo: https://demo.binance.com (more realistic market data; dedicated demo keys)
# In Testnet mode this bot reads candles from Binance public Spot market data;
# account, order-book, and order requests use Spot Testnet.
# Create demo keys at Binance Demo Trading > API Key Management.
EXCHANGE=binance
# Keep testnet keys separate from demo keys. The selected paper environment
# uses only its matching key pair.
API_KEY=your_testnet_api_key_here
API_SECRET=your_testnet_api_secret_here
DEMO_API_KEY=your_binance_demo_api_key_here
DEMO_API_SECRET=your_binance_demo_api_secret_here

# Keep true. Change PAPER_ENVIRONMENT to "demo" after adding demo keys.
PAPER_TRADING=true
PAPER_ENVIRONMENT=testnet
# Keep false so rejected/misconfigured Testnet keys cannot silently switch the
# dashboard and worker to a virtual wallet. Set true only for intentional fallback simulation.
FALLBACK_TO_SIMULATION=false

# Live order placement is deliberately blocked by this build. Keep false.
ALLOW_LIVE_TRADING=false

# Virtual starting balance used by the simulated/fallback wallet and dashboard
# display only. The real account balance is always read from the exchange.
INITIAL_BALANCE=10000

# NOTE: Binance "BNB fee discount" (a third-asset commission) is now converted
# into quote P&L using a contemporaneous BNB/USDT price and reconciled
# fail-closed when that price is unavailable. No pre-launch BNB-fee setting is
# required; an unpriced commission still halts the affected trade for review.

# Required to protect every dashboard/API endpoint (generate a long random value).
DASHBOARD_TOKEN=replace_with_a_long_random_secret

# Optional Postgres/Supabase persistence. Leave empty to keep SQLite.
# Use Supabase direct (IPv6-capable) or Session Pooler (port 5432), not Transaction Pooler.
# Keep this secret only in Railway variables; the app refuses to start until legacy state is imported.
DATABASE_URL=

# On Railway, mount a Volume at /app/data and set DATA_DIR=/app/data.
DATA_DIR=data

# --- Trading Pairs ---
# Comma-separated list of trading pairs to monitor.
# Default is the three symbols with a validated positive edge. The 2026-11-15
# readiness analysis and the independent review both show the wider 8-symbol
# universe is net-negative in the 2026 holdout and materially worsens drawdown.
# BNB, XRP, ADA, DOGE, LINK remain opt-in: add them back only for deliberate
# diversification research, not for validated profitability.
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT

# --- Risk Management ---
# Maximum percentage of portfolio to risk per trade (1-2% recommended)
MAX_RISK_PER_TRADE=1.0

# Maximum number of simultaneous open positions
MAX_OPEN_POSITIONS=3

# Stop-loss percentage (how much loss before auto-selling)
STOP_LOSS_PCT=2.0

# Take-profit percentage (how much gain before auto-selling)
TAKE_PROFIT_PCT=3.0

# Maximum percentage of portfolio to lose in a single day before stopping
MAX_DAILY_LOSS_PCT=3.0
MAX_ROLLING_DRAWDOWN_PCT=5.0
MAX_CONSECUTIVE_LOSSES=3
# Consecutive-loss budgets are now route-scoped: the uptrend EMA72 route and the
# opt-in downtrend recovery route each keep their own streak, so a run of losing
# downtrend trades no longer halts the better uptrend route. The legacy combined
# route keeps the original portfolio-wide behavior. The 2026-11-15 halt-cap sweep
# (research/ema72_halt_cap_sweep) shows the EMA72 route is positive at a 4-loss
# budget in validation, so 4-5 is allowed for the EMA72/dynamic profiles; the
# default stays 3 (conservative). Route halts are visible in /api/status
# (route_halts) and cleared via POST /api/clear-route-halts.
# Start with entries paused (EXIT_ONLY) until the operator resumes them.
START_PAUSED=false

# Percentage of available balance to use per trade
POSITION_SIZE_PCT=10.0
MAX_SPREAD_BPS=20
MAX_SLIPPAGE_BPS=30
# Halt for review if a fill lands further than this (in basis points) from the
# closed-candle price that generated the signal. Guards against stale signals.
MAX_SIGNAL_FILL_DIVERGENCE_BPS=100
MAX_PAIRWISE_CORRELATION=0.85

# --- Strategy Settings ---
# Available strategies: macro_donchian_ema72, dynamic_regime, combined,
# ema_crossover, rsi_mean_reversion, macd.
# Default: EMA72/Donchian (D168_M480_E72). In the independent cost-adjusted
# replay this candidate had the highest profit factor of any evaluated option
# (train 1.58 / validation 1.65 at base costs). It remains a Testnet research
# candidate, not a validated edge, and live orders stay blocked.
# dynamic_regime adds a three-closed-bar regime gate but was worse on profit
# factor and drawdown in train and validation on the same data.
STRATEGY=macro_donchian_ema72

# Timeframe for candle data (1h recommended for low noise; 15m for more frequent trades)
TIMEFRAME=1h

# Number of historical candles to fetch for analysis
LOOKBACK_CANDLES=2500

# Fixed regime gate for the combined strategy: pause new buys in weak trends
# or when ATR as a share of price exceeds the configured ceiling.
# These thresholds do not adapt automatically.
REGIME_FILTER_ENABLED=true
MIN_TREND_ADX=20
MAX_ATR_PCT=3.0

# EMA72 Donchian candidate trial (Testnet only):
# STRATEGY=macro_donchian_ema72
# TIMEFRAME=1h
# LOOKBACK_CANDLES=2500 completed candles; the exchange connector requests one extra raw candle internally
# EMA72_MAX_ATR_PCT=2.5 skips new breakouts only when ATR14 exceeds this share of
# price. The 2026-11-15 tuning sweep found equal profit factor with lower drawdown
# in train and validation; exits are never gated by volatility.
# EMA72_TAKE_PROFIT_ATR_MULTIPLE=100 sets the distant take-profit backstop in ATR14
# multiples. 100 approximates an uncapped trend target (low win rate, high payoff).
# Lowering to 2.0 raises the win rate to ~60% but cuts the trend payoff and profit
# factor; see research/backtest_readiness_analysis.py for the measured trade-off.
# For dynamic_regime the same warmup is required; it uses the EMA72 candidate only
# after three completed hourly candles agree on a stable uptrend.
# ENABLE_DOWNTREND_RECOVERY_TESTNET=false keeps the downtrend RSI recovery route
# entry-disabled (its independent replay was net-negative, PF < 1, in every
# historical slice). Set to true only to opt into the low-risk (0.20% equity
# risk, one position) Testnet execution experiment; it is not a validated edge.
# DOWNTREND_RSI_RECOVERY_LEVEL=25 sets the RSI(14) oversold trigger for that
# experiment. The 2026-11-15 sweep (research/backtest_downtrend_variants.py)
# found the deeper 25 threshold trades less but with a higher profit factor
# than the original 40 (validation PF 1.26 vs 0.29, review PF 1.55 vs 1.01).
# Valid range 10-45. No long-only downtrend candidate passed the PF screen in
# all three slices, so the route remains an opt-in Testnet experiment only.
# In Testnet mode, candles come from Binance's public Spot market-data API without credentials.
# Account, order-book, and order requests remain on Spot Testnet; entries require prices within 0.5%.
# MAX_TESTNET_PRICE_DIVERGENCE_PCT=0.5
# Config validation rejects either candidate profile outside Binance Spot Testnet.

# --- Notifications ---
# Set to true to enable console notifications for trades
ENABLE_NOTIFICATIONS=true

# Optional: Instant Telegram alerts for buys, sells, stop-loss, and take-profit
# Create a bot via @BotFather on Telegram, then get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: email/carrier-SMS alerts via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# Optional: Discord webhook for push alerts (keep the URL secret)
DISCORD_WEBHOOK_URL=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log

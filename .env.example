# ============================================================
# AUTOMATED CRYPTO TRADING BOT - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================================

# --- Exchange Configuration ---
# Paper trading modes for Binance:
#   testnet: https://testnet.binance.vision (separate account and order book)
#   demo: https://demo.binance.com (more realistic market data; dedicated demo keys)
# In Testnet mode this bot reads candles from Binance public Spot market data;
# account, order-book, and order requests use Spot Testnet.
# Create demo keys at Binance Demo Trading > API Key Management.
EXCHANGE=binance
# Keep testnet keys separate from demo keys. The selected paper environment
# uses only its matching key pair.
API_KEY=your_testnet_api_key_here
API_SECRET=your_testnet_api_secret_here
DEMO_API_KEY=your_binance_demo_api_key_here
DEMO_API_SECRET=your_binance_demo_api_secret_here

# Keep true. Change PAPER_ENVIRONMENT to "demo" after adding demo keys.
PAPER_TRADING=true
PAPER_ENVIRONMENT=testnet
# Keep false so rejected/misconfigured Testnet keys cannot silently switch the
# dashboard and worker to a virtual wallet. Set true only for intentional fallback simulation.
FALLBACK_TO_SIMULATION=false

# Live order placement is deliberately blocked by this build. Keep false.
ALLOW_LIVE_TRADING=false

# Required to protect every dashboard/API endpoint (generate a long random value).
DASHBOARD_TOKEN=replace_with_a_long_random_secret

# Optional Postgres/Supabase persistence. Leave empty to keep SQLite.
# Use Supabase direct (IPv6-capable) or Session Pooler (port 5432), not Transaction Pooler.
# Keep this secret only in Railway variables; the app refuses to start until legacy state is imported.
DATABASE_URL=

# On Railway, mount a Volume at /app/data and set DATA_DIR=/app/data.
DATA_DIR=data

# --- Trading Pairs ---
# Comma-separated list of trading pairs to monitor
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT

# --- Risk Management ---
# Maximum percentage of portfolio to risk per trade (1-2% recommended)
MAX_RISK_PER_TRADE=1.0

# Maximum number of simultaneous open positions
MAX_OPEN_POSITIONS=3

# Stop-loss percentage (how much loss before auto-selling)
STOP_LOSS_PCT=2.0

# Take-profit percentage (how much gain before auto-selling)
TAKE_PROFIT_PCT=3.0

# Maximum percentage of portfolio to lose in a single day before stopping
MAX_DAILY_LOSS_PCT=3.0
MAX_ROLLING_DRAWDOWN_PCT=5.0
MAX_CONSECUTIVE_LOSSES=3

# Percentage of available balance to use per trade
POSITION_SIZE_PCT=10.0
MAX_SPREAD_BPS=20
MAX_SLIPPAGE_BPS=30
MAX_PAIRWISE_CORRELATION=0.85

# --- Strategy Settings ---
# Available strategies: dynamic_regime, combined, ema_crossover,
# rsi_mean_reversion, macd, macro_donchian_ema72.
# Dynamic routing is Testnet-only: EMA72 trend candidate on stable uptrends,
# otherwise no new entries until another strategy passes cost-adjusted review.
STRATEGY=dynamic_regime

# Timeframe for candle data (1h recommended for low noise; 15m for more frequent trades)
TIMEFRAME=1h

# Number of historical candles to fetch for analysis
LOOKBACK_CANDLES=2500

# Fixed regime gate for the combined strategy: pause new buys in weak trends
# or when ATR as a share of price exceeds the configured ceiling.
# These thresholds do not adapt automatically.
REGIME_FILTER_ENABLED=true
MIN_TREND_ADX=20
MAX_ATR_PCT=3.0

# EMA72 Donchian candidate trial (Testnet only):
# STRATEGY=macro_donchian_ema72
# TIMEFRAME=1h
# LOOKBACK_CANDLES=2500 completed candles; the exchange connector requests one extra raw candle internally
# For dynamic_regime the same warmup is required; it uses the EMA72 candidate only
# after three completed hourly candles agree on a stable uptrend.
# In Testnet mode, candles come from Binance's public Spot market-data API without credentials.
# Account, order-book, and order requests remain on Spot Testnet; entries require prices within 0.5%.
# MAX_TESTNET_PRICE_DIVERGENCE_PCT=0.5
# Config validation rejects either candidate profile outside Binance Spot Testnet.

# --- Notifications ---
# Set to true to enable console notifications for trades
ENABLE_NOTIFICATIONS=true

# Optional: Instant Telegram alerts for buys, sells, stop-loss, and take-profit
# Create a bot via @BotFather on Telegram, then get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
